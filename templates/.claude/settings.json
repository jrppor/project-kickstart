{
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * show*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git * --no-verify*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git -* push --force*)",
      "Bash(git -* push -f*)",
      "Bash(git -* push * --force)",
      "Bash(git -* push * --force *)",
      "Bash(git -* push +*)",
      "Bash(git -* push * +*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git * --output*)",
      "Bash(git -C * -c *=*)",
      "Bash(git -C * --config-env*)",
      "Bash(git -C *[*)",
      "Bash(git -C *?*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git * --no-verify*)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push +*)",
      "PowerShell(git push * +*)",
      "PowerShell(git -* push --force*)",
      "PowerShell(git -* push -f*)",
      "PowerShell(git -* push * --force)",
      "PowerShell(git -* push * --force *)",
      "PowerShell(git -* push +*)",
      "PowerShell(git -* push * +*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n)",
      "PowerShell(git commit * -n *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.*.local)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git -* reset --hard*)",
      "Bash(git clean *)",
      "Bash(git -* clean -*)",
      "Bash(git branch -D *)",
      "Bash(git -* branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git -* checkout -- *)",
      "Bash(git restore *)",
      "Bash(git -* restore *)",
      "Bash(git stash drop*)",
      "Bash(git -* stash drop*)",
      "Bash(git worktree remove --force*)",
      "Bash(git -* worktree remove --force*)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose * down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker compose * down --volumes*)",
      "Bash(docker volume rm *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git worktree remove --force*)",
      "PowerShell(git -* reset --hard*)",
      "PowerShell(git -* clean -*)",
      "PowerShell(git -* checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git -* restore *)",
      "PowerShell(git stash drop*)",
      "PowerShell(git -* stash drop*)",
      "PowerShell(git -* worktree remove --force*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker compose * down -v*)",
      "PowerShell(docker compose down --volumes*)",
      "PowerShell(docker compose * down --volumes*)",
      "PowerShell(docker volume rm *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(Remove-Item -r*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" format",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" commit",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" stop",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" subagent-stop",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" subagent-start",
            "timeout": 20
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" worktree-create",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
