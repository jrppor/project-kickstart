{
  "permissions": {
    "allow": [
      "Edit(/**)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git * --no-verify*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git -* push --force*)",
      "Bash(git -* push -f*)",
      "Bash(git -* push * --force)",
      "Bash(git -* push * --force *)",
      "Bash(git -* push +*)",
      "Bash(git -* push * +*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git * --no-verify*)",
      "PowerShell(git push +*)",
      "PowerShell(git push * +*)",
      "PowerShell(git -* push --force*)",
      "PowerShell(git -* push -f*)",
      "PowerShell(git -* push * --force)",
      "PowerShell(git -* push * --force *)",
      "PowerShell(git -* push +*)",
      "PowerShell(git -* push * +*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n)",
      "PowerShell(git commit * -n *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.development)",
      "Read(**/.env.*.local)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git worktree remove --force*)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git worktree remove --force*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(Remove-Item *-Recurse*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" format",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" stop",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\" subagent-stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
